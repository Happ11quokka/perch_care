<mxfile host="app.diagrams.net">
  <diagram id="rag-pipeline" name="RAG Pipeline">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="650" background="#FFFFFF" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
        <mxCell id="title" value="Axis 1 -- RAG Knowledge Pipeline" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2B2B2B;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="grp1" value="&lt;i&gt;Query-time Retrieval&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#AAAAAA;fillColor=none;verticalAlign=top;align=left;spacingTop=8;spacingLeft=14;fontColor=#999999;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1850" height="245" as="geometry" /></mxCell>
        <mxCell id="user_q" value="&lt;b&gt;User Question&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#5a5a5a;'&gt;ko / en / zh&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="hyde" value="&lt;b&gt;HyDE Generation&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#5a5a5a;'&gt;gpt-4o-mini&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="embed" value="&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#5a5a5a;'&gt;text-embedding-3-large&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="vsearch" value="&lt;b&gt;Vector Search&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#5a5a5a;'&gt;pgvector HNSW, top_k=5&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="190" height="70" as="geometry" /></mxCell>
