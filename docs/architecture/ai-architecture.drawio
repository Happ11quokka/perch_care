        <mxCell id="context" value="&lt;b&gt;Context Assembly&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#5a5a5a;'&gt;top-5 + chat history&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1660" y="150" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="hyde_fb" value="&lt;b&gt;Timeout Fallback&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:10px;color:#5a5a5a;'&gt;use raw query&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="250" width="170" height="55" as="geometry" /></mxCell>
