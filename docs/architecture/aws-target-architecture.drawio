        <mxCell id="fx" parent="1" style="text;html=1;fontSize=13;fontColor=#232F3E;align=left;labelBackgroundColor=#FFFFFF;" value="&lt;b&gt;이전 전에 반드시 고쳐야 하는 것&lt;/b&gt;" vertex="1">
