        <mxCell id="q2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0E5;strokeColor=none;fontColor=#277116;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" value="이 시점까지는 앱이 여전히 Railway에서 돌고 있다. 중단 없이 되돌릴 수 있는 구간." vertex="1">
          <mxGeometry height="60" width="380" x="65" y="420" as="geometry" />
        </mxCell>
        <mxCell id="q3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D05C17;strokeWidth=2;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;3 · 인메모리 상태 → ElastiCache&lt;/b&gt;  &lt;font color=&quot;#C7131F&quot;&gt;컴퓨트를 옮기기 전에 해야 한다.&lt;/font&gt; 안 하면 태스크 2개째에서 레이트리밋이 뚫린다. &lt;font color=&quot;#D05C17&quot;&gt;코드: limiter storage_uri + dedup 로직&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="515" y="150" as="geometry" />
        </mxCell>
        <mxCell id="q4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D05C17;strokeWidth=2;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;4 · 앱 → ECS Fargate&lt;/b&gt;  1–3이 끝나야 비로소 안전하게 수평 확장된다. &lt;font color=&quot;#D05C17&quot;&gt;코드: 마이그레이션 태스크 분리, create_all 제거, 헬스체크 경로 설정&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="515" y="285" as="geometry" />
        </mxCell>
        <mxCell id="q5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D05C17;strokeWidth=2;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;5 · 배치·백그라운드 → EventBridge + SQS&lt;/b&gt;  태스크가 여러 개가 된 뒤 중복 실행이 실제로 발생한다. &lt;font color=&quot;#D05C17&quot;&gt;코드: 스케줄러 제거, 워커 진입점 추가&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="380" x="515" y="420" as="geometry" />
        </mxCell>
        <mxCell id="q6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A30B5;strokeWidth=2;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;6 · 관측 · 보안 계층&lt;/b&gt;  트래픽이 붙기 전에 대시보드와 알람이 서 있어야 한다. CloudWatch · X-Ray · WAF · KMS · GuardDuty" vertex="1">
          <mxGeometry height="110" width="420" x="965" y="150" as="geometry" />
        </mxCell>
        <mxCell id="q7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A30B5;strokeWidth=2;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;7 · 데이터레이크&lt;/b&gt;  &lt;font color=&quot;#C7131F&quot;&gt;B2B 계약이 실제로 생긴 뒤.&lt;/font&gt; 먼저 지으면 빈 창고다. S3 Lake · Glue · Athena · Lake Formation" vertex="1">
          <mxGeometry height="110" width="420" x="965" y="285" as="geometry" />
        </mxCell>
        <mxCell id="q8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A30B5;strokeWidth=2;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;8 · 중국 파티션&lt;/b&gt;  법인·ICP가 준비된 뒤. &lt;font color=&quot;#C7131F&quot;&gt;기술이 아니라 법무가 선행한다.&lt;/font&gt; 별도 계정 · arn:aws-cn · Bedrock 없음" vertex="1">
          <mxGeometry height="95" width="420" x="965" y="420" as="geometry" />
        </mxCell>
